    {
      "parameters": {
        "jsCode": "const raw = $json.data ?? $json.body ?? $json;\nconst html = typeof raw === 'string' ? raw : JSON.stringify(raw);\nconst withoutNoise = html\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<nav[\\s\\S]*?<\\/nav>/gi, ' ')\n  .replace(/<footer[\\s\\S]*?<\\/footer>/gi, ' ')\n  .replace(/<header[\\s\\S]*?<\\/header>/gi, ' ')\n  .replace(/<svg[\\s\\S]*?<\\/svg>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;/gi, ' ')\n  .replace(/&amp;/gi, '&')\n  .replace(/&lt;/gi, '<')\n  .replace(/&gt;/gi, '>')\n  .replace(/\\s+/g, ' ')\n  .trim();\nreturn [{ json: { sourceType: 'url', source: $item(0).$node['Webhook'].json.body.value, title: $item(0).$node['Webhook'].json.body.value, content: withoutNoise.slice(0, 70000) } }];"
      },
