        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'openrouter/free', temperature: 0.2, response_format: { type: 'json_object' }, messages: [{ role: 'system', content: 'You are a senior developer advocate. Summarize technical documentation into structured notes for another developer. Be accurate, concrete, and avoid inventing APIs. Return ONLY valid JSON matching the requested schema.' }, { role: 'user', content: `Create a summary using this schema exactly: {title:string, source:string, sourceType:'url'|'text', oneLiner:string, readingTime:number, difficulty:'Beginner'|'Intermediate'|'Advanced', concepts:string[], sections:[{title:string, paragraphs:string[], bullets?:string[], code?:string}], quickStart?:string, caveats?:string[], generatedAt:string}. Source type: ${$json.sourceType}. Source: ${$json.source}. Documentation: ${$json.content}` }] }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "1b367689-d48c-45cd-9b95-f689544f173f",
      "name": "Generate Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        112
      ],
      "credentials": {
        "openAiApi": {
          "id": "JfsEb0klRtcfvu2o",
          "name": "OpenAI account"
        },
        "openRouterApi": {
          "id": "H5axlitmB2xwhbca",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const body = $json;\nconst content = body.choices?.[0]?.message?.content ?? body.output_text ?? '';\nlet parsed;\ntry { parsed = JSON.parse(content); } catch {\n  const match = content.match(/\\{[\\s\\S]*\\}/);\n  if (!match) throw new Error('LLM did not return valid JSON');\n  parsed = JSON.parse(match[0]);\n}\nif (!parsed.title || !Array.isArray(parsed.sections)) throw new Error('Summary shape is invalid');\nreturn [{ json: { ...parsed, generatedAt: parsed.generatedAt || new Date().toISOString() } }];"
      },
